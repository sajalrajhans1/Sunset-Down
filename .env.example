# Leaderboard configuration.
#
# Copy to .env.local for local development, and set the same three values in
# Vercel under Settings → Environment Variables for production.
#
# Leave them unset and the game still runs — the leaderboard simply falls back
# to a board stored in each player's own browser.

# Upstash Redis, created from the Vercel Marketplace or upstash.com.
# Both values are shown on the database page under "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the run tokens that let the server time a run it did not observe.
# Any long random string. Generate one with:  openssl rand -hex 32
# Changing it invalidates every run currently in progress, nothing more.
LEADERBOARD_SECRET=

# Leaderboard configuration.
#
# Copy to .env.local for local development, and set the same three values in
# Vercel under Settings → Environment Variables for production.
#
# Leave them unset and the game still runs — the leaderboard simply falls back
# to a board stored in each player's own browser.

# Upstash Redis. Either naming convention works.
#
# Creating the database from the Vercel Marketplace injects the KV_ pair into
# your project automatically — you do not need to add them by hand there, only
# here for local development.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative names, used when the database is created directly at upstash.com.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Signs the run tokens that let the server time a run it did not observe.
# Any long random string. Generate one with:  openssl rand -hex 32
# Changing it invalidates every run currently in progress, nothing more.
LEADERBOARD_SECRET=
